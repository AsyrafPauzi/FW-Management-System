# Deny script execution in uploads (Apache)
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|phar|cgi|pl|py|jsp|asp|aspx|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .phar
